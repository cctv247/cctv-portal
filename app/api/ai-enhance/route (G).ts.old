// app/api/ai-enhance/route.ts
import { NextResponse } from "next/server";

export async function POST(req: Request) {
  try {
    const { text, type, lang = "en" } = await req.json();

    if (!text || !text.trim()) {
      return NextResponse.json({ error: "Please enter some text first." }, { status: 400 });
    }

    const apiKey = process.env.GEMINI_API_KEY;
    if (!apiKey) {
      return NextResponse.json({ error: "GEMINI_API_KEY missing in .env.local" }, { status: 500 });
    }

    const langMap: Record<string, string> = {
      en: "formal technical English",
      hi: "formal technical Hindi in Devanagari script (औपचारिक हिंदी)",
      mr: "formal technical Marathi in Devanagari script (औपचारिक मराठी)"
    };

    const prompt = `You are an expert CCTV and Digital Security Systems Engineer.
Convert this raw technician note into 1 or 2 complete, professional technical sentences in ${langMap[lang] || "formal technical English"}.

Field Context: ${type === "work_done" ? "Work Description" : "Technical Remarks"}
Input Note: "${text}"

Instructions:
- Write a COMPLETE, clear, and professional technical statement.
- Use precise security terms (e.g. CCTV, CMOS/RTC battery, power surge/fluctuation, DVR/NVR, video feed).
- Output ONLY the finished text. Do not include quotes, greetings, or formatting asterisks.`;

    const payload = {
      contents: [{ role: "user", parts: [{ text: prompt }] }],
      generationConfig: {
        temperature: 0.2,
        maxOutputTokens: 300
      }
    };

    const response = await fetch(
      `https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent?key=${apiKey}`,
      {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      }
    );

    const data = await response.json();

    if (data.error) {
      if (data.error.code === 429) {
        return NextResponse.json(
          { error: "AI service limit reached for this minute. Please wait 30-40 seconds and try again." },
          { status: 429 }
        );
      }
      return NextResponse.json({ error: data.error.message || "Model request failed" }, { status: 500 });
    }

    const polishedText = data.candidates?.[0]?.content?.parts?.[0]?.text?.trim() || text;
    return NextResponse.json({ polishedText });
  } catch (error: any) {
    console.error("Server Error:", error);
    return NextResponse.json({ error: error.message || "Internal Server Error" }, { status: 500 });
  }
}